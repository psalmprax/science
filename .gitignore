# Byte-compiled / optimized / DLL files
__pycache__/
*.py[c]
*.pyo

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/

# Linting
.ruff_cache/
.mypy_cache/

# Jupyter
.ipynb_checkpoints

# Environment — any python venv by name or variant suffix (hardened: attypical
# venv directory names must never surface as git-status noise).
.venv/
.venv-*/
.venv*/
env/
env-*/
venv/
venv-*/
venv*/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Generated
*.md.bak

# Per-run experiment artifacts: one timestamped directory per run, each holding
# that run's checkpoint, hall_of_fame and report files. 150+ of these accumulate
# in a day and bury real work in `git status`. Results that are meant to be
# compared or reproduced are copied out of here, not committed from here.
outputs/

# Rust kernel: cargo build output. `rust/apedp-kernel/target/` is several GB
# of intermediate artifacts and is rebuilt by `maturin develop`.
rust/**/target/
target/

# Compiled extension modules built by maturin, when it lands one in-tree.
*.so
*.dylib
*.pyd

# Colab sample datasets
mnist_*.csv
california_housing_*.csv

# Audit logs (request/response records, unbounded growth)
logs/

# Generated benchmark media and trained model weights: same policy as outputs/
# (copy out what must be compared or reproduced; never commit the blobs).
artifacts/
checkpoints/
docs/media/
.gstack/

# Large binary circuit artifacts: a single .kmb receipt is ~845 MB, and until
# 2026-10-31 the index carried four copies of the same one. Only the canonical
# receipt that the `prepare_*_artifacts.py` scripts read is tracked; copies are
# produced from it on demand. (Tracked before this rule existed, so the three
# below are removed from the index rather than from the working tree.)
apedp_dyn/sandbox/google-verifiable-quantum-circuit-compilation/sample_submission/dqi.kmb
apedp_dyn/sandbox/google-verifiable-quantum-circuit-compilation/google-verifiable-quantum-circuit-compilation.zip
artifacts/quantum_compilation/dqi/iteration_sweep_receipts/dqi_niters_216.kmb

# Artifacts over GitHub's 100 MB per-file limit: kept on disk, fetched separately,
# never re-added. The FCIDUMP's size and SHA-256 are pinned in
# verifiers/dfthcsos/SCORING_README.md, so a re-download is verifiable.
apedp_dyn/sandbox/google-verifiable-quantum-circuit-compilation/verifiers/dfthcsos/FeMoCo76o113e.fcidump
artifacts/quantum_compilation/dqi/iteration_sweep_receipts/dqi_niters_222.kmb
/.agents/
/.claude/
/skills-lock.json

# Local audit output: mypy/ruff/pytest logs from agent sessions
.artifacts/
submission/
unused/

# Vendored Qualtran source: gitlink removed (its remote 404s), local copy is residue
apedp_dyn/sandbox/google-verifiable-quantum-circuit-compilation/kickmix/_qualtran_src/
